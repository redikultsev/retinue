# Every night at 03:30 in the owner's zone, whatever the server's own: setup.sh writes OWNER_TZ in place of UTC
# below. Persistent: a night missed while the server was off runs right after boot. The router reports a backup older than 26 hours, so the delay below is safe.
[Unit]
Description=Retinue backup every night

[Timer]
OnCalendar=*-*-* 03:30 UTC
RandomizedDelaySec=15m
Persistent=true

[Install]
WantedBy=timers.target
