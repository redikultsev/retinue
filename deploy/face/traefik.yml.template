# The face's middlewares. setup.sh renders this file to /etc/dokploy/traefik/dynamic/face.yml (root, 600): it carries
# the key nginx checks. Only the owner's devices (their WireGuard addresses, one each: the life hub's list when the
# hub is on) get through; everyone else gets 404, as if there were no site — over plain HTTP too. A Mac whose agents
# use /mcp/mac is one of them: a WireGuard peer, its address in DEVICES (docs/collections.md «From the Mac»).
http:
  middlewares:
    face-owner:
      ipAllowList:
        sourceRange: [${FACE_RANGES}]
        rejectStatusCode: 404
    face-key:
      headers:
        customRequestHeaders:
          X-Face-Key: "${FACE_KEY}"
    face-https:
      redirectScheme:
        scheme: https
        permanent: true
