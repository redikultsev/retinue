# The life hub: the builder's live release, read-only. setup.sh renders this file with the key (LIFEHUB_KEY from
# secrets.env): Traefik adds it to every request after its own check of the owner's devices; a neighbour on
# dokploy-network that reaches this container directly does not have it and gets 404.
server {
    listen 8080;
    server_name _;
    root /site/current;
    index index.html;
    charset utf-8;
    server_tokens off;
    autoindex off;

    if ($http_x_lifehub_key != "${LIFEHUB_KEY}") { return 404; }

    add_header Content-Security-Policy "default-src 'self'; form-action 'self'; base-uri 'none'; frame-ancestors 'none'; object-src 'none'" always;
    add_header Referrer-Policy "no-referrer" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "DENY" always;
    add_header X-Robots-Tag "noindex, nofollow" always;
    add_header Cache-Control "no-cache" always;

    location ~ /\. { return 404; }
    location / { try_files $uri $uri/ =404; }
}
