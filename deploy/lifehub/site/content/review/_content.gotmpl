{{- /* The review's slices as pages: data/review.json lists them, cut by the router; /review/ itself is «all», page 1.
     A path is checked again here: lower-case letters, digits and dashes only. */ -}}
{{- with resources.Get "review.json" -}}
  {{- $r := . | transform.Unmarshal -}}
  {{- range $r.views -}}
    {{- if and (ne .path "all") (findRE "^[a-z0-9-]{1,40}$" .path) -}}
      {{- $.AddPage (dict "path" .path "title" (printf "Разбор: %s" .title) "kind" "page"
          "params" (dict "review" .path) "content" (dict "mediaType" "text/markdown" "value" "")) -}}
    {{- end -}}
  {{- end -}}
{{- end -}}
